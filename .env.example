# Postgres (Neon in production: use the pooled URL for DATABASE_URL and the direct URL for DIRECT_URL)
DATABASE_URL="postgresql://invitely:invitely@localhost:5544/invitely"
DIRECT_URL="postgresql://invitely:invitely@localhost:5544/invitely"

# Public URL of the site. PayWay must be able to reach APP_URL/api/payway/callback,
# so use a tunnel URL (cloudflared / ngrok) when testing real sandbox payments locally.
APP_URL="http://localhost:3000"

# Random long strings (e.g. `openssl rand -base64 32`)
SESSION_SECRET="change-me"
ADMIN_PASSWORD="change-me"
CRON_SECRET="change-me"

# ABA PayWay (from your merchant onboarding email)
PAYWAY_BASE_URL="https://checkout-sandbox.payway.com.kh"
PAYWAY_MERCHANT_ID=""
PAYWAY_API_KEY=""

# Development only: when "1" and PayWay keys are empty, checkout shows a simulated payment
# button so the whole flow can be tested without a merchant account. Ignored in production.
PAYWAY_MOCK="1"

# Optional: Telegram bot that sends the access code to the customer
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Optional locally (falls back to public/uploads); required on Vercel for photo uploads
BLOB_READ_WRITE_TOKEN=""
